# Personal wordbook exports contain Youdao's copyrighted dictionary definitions —
# never commit them. Only the hand-written sample_wordbook.xml is tracked.
*.xml
!sample_wordbook.xml

# Local caches of third-party content (Tatoeba / Wiktionary sentences, phonetics, audio)
examples-cache.json
phonetic-cache.json
audio-cache/
image-cache/

# Study-state mirror and port memory written by server.js — state.json holds
# a copy of the imported wordbook (Youdao content), never commit it
state.json
last-port.json
